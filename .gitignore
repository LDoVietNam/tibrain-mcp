# TiBrain — Allowlist .gitignore
# Only push: *.md *.go *.yml *.json *.sh *.cmd *.bat *.ps1
# Plus: Makefile, Dockerfile, .gitignore, .gitattributes, .gitkeep

# Ignore everything by default
*

# Hard block: directories (match at any depth)
**/node_modules/
**/.runtime/
**/.kilo/
**/.ti-audit/
**/.mimocode/
**/logs/
**/bin/
**/tmp/
**/build/
**/data/
**/.claude/
**/.codex/

# GitHub CI whitelist (keep .github/ tracked)
!.github/
!.github/workflows/
!.github/workflows/*.yml

# TiBrain essentials (whitelist)
!main.go
!Makefile
!Dockerfile
!docker-compose.yml
!go.mod
!go.sum
!.gitmodules
!.golangci.yml
!*.md
!*.go
!*.mod
!*.sum
!*.yml
!*.yaml
!*.json
!*.sh
!*.bat
!*.ps1

# Internal packages — unignore parent dirs first, then Go sources
!internal/
!internal/**/
!internal/**/*.go